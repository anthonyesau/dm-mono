},
{
code = "sub zero by zeroinferior;\012sub one by oneinferior;\012sub two by twoinferior;\012sub three by threeinferior;\012sub four by fourinferior;\012sub five by fiveinferior;\012sub six by sixinferior;\012sub seven by seveninferior;\012sub eight by eightinferior;\012sub nine by nineinferior;\012sub plus by plusinferior;\012sub minus by minusinferior;\012sub equal by equalinferior;\012sub parenleft by parenleftinferior;\012sub parenright by parenrightinferior;\012sub hyphen by minusinferior;";
name = sinf;
},
{
