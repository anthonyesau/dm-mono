name = subs;
},
{
code = "# Turn a slash between figures into a fraction slash,\012# but leave dates such as 12/31/2020 alone.\012lookup FracSlash {\012	ignore sub [slash fraction] [zero one two three four five six seven eight nine] [slash fraction]';\012	ignore sub [slash fraction]' [zero one two three four five six seven eight nine] [slash fraction];\012	ignore sub [slash fraction] [zero one two three four five six seven eight nine] [zero one two three four five six seven eight nine] [slash fraction]';\012	ignore sub [slash fraction]' [zero one two three four five six seven eight nine] [zero one two three four five six seven eight nine] [slash fraction];\012	ignore sub [slash fraction] [zero one two three four five six seven eight nine] [zero one two three four five six seven eight nine] [zero one two three four five six seven eight nine] [slash fraction]';\012	ignore sub [slash fraction]' [zero one two three four five six seven eight nine] [zero one two three four five six seven eight nine] [zero one two three four five six seven eight nine] [slash fraction];\012	ignore sub [slash fraction] [zero one two three four five six seven eight nine] [zero one two three four five six seven eight nine] [zero one two three four five six seven eight nine] [zero one two three four five six seven eight nine] [slash fraction]';\012	ignore sub [slash fraction]' [zero one two three four five six seven eight nine] [zero one two three four five six seven eight nine] [zero one two three four five six seven eight nine] [zero one two three four five six seven eight nine] [slash fraction];\012	sub [zero one two three four five six seven eight nine] [slash fraction]' [zero one two three four five six seven eight nine] by fraction.diag;\012} FracSlash;\012lookup FracNumerator {\012	rsub [zero one two three four five six seven eight nine]' [fraction.diag zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr] by [zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr];\012} FracNumerator;\012lookup FracDenominator {\012	sub [fraction.diag zero.dnom one.dnom two.dnom three.dnom four.dnom five.dnom six.dnom seven.dnom eight.dnom nine.dnom] [zero one two three four five six seven eight nine]' by [zero.dnom one.dnom two.dnom three.dnom four.dnom five.dnom six.dnom seven.dnom eight.dnom nine.dnom];\012} FracDenominator;\012# Single-figure fractions that have a stacked Unicode glyph.\012lookup FracPrecomposed {\012	ignore sub [zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr] [zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr]' fraction.diag [zero.dnom one.dnom two.dnom three.dnom four.dnom five.dnom six.dnom seven.dnom eight.dnom nine.dnom];\012	ignore sub [zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr]' fraction.diag [zero.dnom one.dnom two.dnom three.dnom four.dnom five.dnom six.dnom seven.dnom eight.dnom nine.dnom] [zero.dnom one.dnom two.dnom three.dnom four.dnom five.dnom six.dnom seven.dnom eight.dnom nine.dnom];\012	sub one.numr' fraction.diag' four.dnom' by onequarter;\012	sub one.numr' fraction.diag' two.dnom' by onehalf;\012	sub three.numr' fraction.diag' four.dnom' by threequarters;\012	sub one.numr' fraction.diag' seven.dnom' by oneseventh;\012	sub one.numr' fraction.diag' nine.dnom' by oneninth;\012	sub one.numr' fraction.diag' three.dnom' by onethird;\012	sub two.numr' fraction.diag' three.dnom' by twothirds;\012	sub one.numr' fraction.diag' five.dnom' by onefifth;\012	sub two.numr' fraction.diag' five.dnom' by twofifths;\012	sub three.numr' fraction.diag' five.dnom' by threefifths;\012	sub four.numr' fraction.diag' five.dnom' by fourfifths;\012	sub one.numr' fraction.diag' six.dnom' by onesixth;\012	sub five.numr' fraction.diag' six.dnom' by fivesixths;\012	sub one.numr' fraction.diag' eight.dnom' by oneeighth;\012	sub three.numr' fraction.diag' eight.dnom' by threeeighths;\012	sub five.numr' fraction.diag' eight.dnom' by fiveeighths;\012	sub seven.numr' fraction.diag' eight.dnom' by seveneighths;\012	sub zero.numr' fraction.diag' three.dnom' by uni2189;\012} FracPrecomposed;\012# 1/10 has a stacked glyph too\012lookup FracTenth {\012	ignore sub [zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr] one.numr' fraction.diag one.dnom zero.dnom;\012	ignore sub one.numr' fraction.diag one.dnom zero.dnom [zero.dnom one.dnom two.dnom three.dnom four.dnom five.dnom six.dnom seven.dnom eight.dnom nine.dnom];\012	sub one.numr' fraction.diag' one.dnom' zero.dnom' by onetenth;\012} FracTenth;";
name = frac;
},
{
